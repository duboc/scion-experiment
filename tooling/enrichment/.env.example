# Google Cloud project and data sources (replace placeholders with your values)
project_id=PROJECT_ID
bq_dataset=psearch_dataset
bq_table=products_raw
psearch_img_bucket=BUCKET_NAME
firestore_collection=product_enrichment
service_account=SA_NAME@PROJECT_ID.iam.gserviceaccount.com

# Optional Vertex AI model settings
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GENAI_LOCATION=global
